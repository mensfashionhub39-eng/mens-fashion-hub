rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Products: website can read products.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Orders
    // NOTE: These rules allow order creation/read/update without login.
    // They are intended for the current website code and should be
    // tightened after authentication is added.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Customer support queries
    match /queries/{queryId} {
      allow create: if true;
      allow read: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
